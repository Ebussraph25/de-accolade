# ─────────────────────────────────────────────────────────────
# De Accolade — environment variables
# Copy to .env.local for local development. On Vercel, add these
# under Project → Settings → Environment Variables.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public URL of the site. Optional on Vercel: the production domain (your custom domain once
# connected) is detected automatically. Set it only for local development or to force an address.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). Without these the site runs in preview mode on sample stories.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Require every newsroom account to set up two-factor authentication (recommended for production).
REQUIRE_ADMIN_2FA=true

# Any long random string; mixed into hashed IPs for form rate limiting.
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# Contact details shown on the site (optional)
NEXT_PUBLIC_CONTACT_EMAIL=newsroom@deaccolade.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Social profiles (optional; icons only appear for the ones you fill in). YouTube is built in.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_X_URL=

# Agunjiegbe Online Television YouTube channel ID (defaults to @OnuigboEmeka's channel)
YOUTUBE_CHANNEL_ID=UCojC7JrGXuoMsKZQHBJi4oQ

# Google Analytics 4 measurement ID (optional), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console "HTML tag" verification code (optional; the content="..." value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Email alerts to the newsroom for contact-form messages and coverage bookings (optional, via resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=newsroom@deaccolade.com
NOTIFY_EMAIL_FROM=De Accolade <alerts@deaccolade.com>
